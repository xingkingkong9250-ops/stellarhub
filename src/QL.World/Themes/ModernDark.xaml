<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         QL World — Modern Dark theme
         v0.7.0 起与 Dark.xaml 对齐同一品牌色板（深空蓝黑 +
         青蓝主色 + 暖金星光辅色），键与 Dark.xaml 1:1。
         ═══════════════════════════════════════════════════════════ -->

    <!-- Base Colors (deep-space navy) -->
    <Color x:Key="Background">#0A0F16</Color>
    <Color x:Key="Surface">#101822</Color>
    <Color x:Key="SurfaceVariant">#15202D</Color>
    <Color x:Key="SurfaceHover">#1D2B3D</Color>
    <Color x:Key="SurfaceActive">#28405A</Color>
    <Color x:Key="Border">#2C4159</Color>
    <Color x:Key="BorderSubtle">#1E2D3F</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#EEF4FA</Color>
    <Color x:Key="TextSecondary">#A8B8C9</Color>
    <Color x:Key="TextMuted">#8FA1B5</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- Accent (azure-cyan, from the brand frames) -->
    <Color x:Key="Accent">#2288E0</Color>
    <Color x:Key="AccentDim">#71C9FF</Color>
    <Color x:Key="AccentBg">#0C2A42</Color>

    <!-- 品牌辅色：星光金 -->
    <Color x:Key="Gold">#F5CB5C</Color>
    <Color x:Key="GoldDim">#C99E3A</Color>

    <!-- Status -->
    <Color x:Key="Danger">#FF5A52</Color>
    <Color x:Key="DangerBg">#3B1410</Color>
    <Color x:Key="Warning">#FFB020</Color>
    <Color x:Key="WarningBg">#3B2A05</Color>
    <Color x:Key="TextOnWarning">#2A1D00</Color>

    <!-- Overlay (aligned with Dark.xaml keys so all theme dictionaries are interchangeable) -->
    <Color x:Key="Overlay">#CC0A1018</Color>
    <Color x:Key="TextOnOverlay">#E6EEF8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="AccentBgBrush" Color="{StaticResource AccentBg}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}" />
    <SolidColorBrush x:Key="GoldDimBrush" Color="{StaticResource GoldDim}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBg}" />
    <SolidColorBrush x:Key="TextOnWarningBrush" Color="{StaticResource TextOnWarning}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Overlay}" />
    <SolidColorBrush x:Key="TextOnOverlayBrush" Color="{StaticResource TextOnOverlay}" />

    <!-- Brand gradient: cyan frame → blue frame -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E9FC0" Offset="0.0" />
        <GradientStop Color="#3B82F6" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
