<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         QL World — Light theme (M2)
         Bright surfaces with the same violet accent.
         Keys mirror Dark.xaml 1:1.
         ═══════════════════════════════════════════════════════════ -->

    <!-- Base Colors -->
    <Color x:Key="Background">#FAFAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#F2F2F5</Color>
    <Color x:Key="SurfaceHover">#E6E6EA</Color>
    <Color x:Key="SurfaceActive">#D8D8DE</Color>
    <Color x:Key="Border">#D8D8DE</Color>
    <Color x:Key="BorderSubtle">#E6E6EA</Color>

    <!-- Text
         TextMuted minimum contrast vs Surface/SurfaceVariant ≥ 4.5:1 (WCAG AA)
         — #6E6E78 measures 5.0:1 on Surface, 4.5:1 on SurfaceVariant. -->
    <Color x:Key="TextPrimary">#1A1A22</Color>
    <Color x:Key="TextSecondary">#5A5A66</Color>
    <Color x:Key="TextMuted">#6E6E78</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- Accent (violet) -->
    <Color x:Key="Accent">#6B4DFF</Color>
    <Color x:Key="AccentDim">#4A2EE0</Color>
    <Color x:Key="AccentBg">#ECE8FF</Color>

    <!-- Status
         Warning doubles as small-text color (rating ★, missing-file chip);
         #8F6400 keeps ≥ 4.5:1 on Surface, SurfaceVariant and WarningBg. -->
    <Color x:Key="Danger">#D93832</Color>
    <Color x:Key="DangerBg">#FBE5E3</Color>
    <Color x:Key="Warning">#8F6400</Color>
    <Color x:Key="WarningBg">#FFF1D6</Color>

    <!-- Translucent cover laid over gallery thumbnails (file-missing badge);
         must adapt per theme instead of a hardcoded dark overlay. -->
    <Color x:Key="Overlay">#CCFFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="AccentBgBrush" Color="{StaticResource AccentBg}" />
    <!-- U2-A: brand gradient for Logo / AI button hover / C1 progress bar only -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Accent}" />
        <GradientStop Offset="1" Color="{StaticResource AccentDim}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBg}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Overlay}" />

</ResourceDictionary>
