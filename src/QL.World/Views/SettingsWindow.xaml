<Window x:Class="QL.World.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:QL.World.Views.Converters"
        mc:Ignorable="d"
        Width="480" Height="640"
        MinWidth="480" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Title="设置 — 千星汇图">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:EnumEqualityConverter x:Key="EnumEq" />
        <conv:BoolToTextConverter x:Key="BoolText" />
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="12" Background="Transparent"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">

            <!-- ═══ A1 常规 ═══ -->
            <TabItem Header="常规">
                <StackPanel Margin="14,12">
                    <TextBlock Text="主题" Style="{StaticResource SectionCaptionStyle}" />
                    <ComboBox Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme}" />
                    <TextBlock Text="启动时校验素材库完整性" Margin="0,18,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="每次启动时检查缺失文件与数据库结构"
                              Margin="0,4,0,0"
                              IsChecked="{Binding CheckIntegrityOnStartup}" />
                </StackPanel>
            </TabItem>

            <!-- ═══ A2 缩略图 ═══ -->
            <TabItem Header="缩略图">
                <StackPanel Margin="14,12">
                    <TextBlock Text="缩略图尺寸（长边，128–512 像素）"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <Slider Minimum="128" Maximum="512" TickFrequency="16"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ThumbnailSize}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ThumbnailSize, StringFormat={}{0} px}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />

                    <TextBlock Text="WebP 质量（30–100）" Margin="0,18,0,0"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <Slider Minimum="30" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ThumbnailQuality}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ThumbnailQuality, StringFormat='质量 {0}'}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />

                    <Button Content="全部重新生成缩略图" Margin="0,18,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding RegenerateAllThumbnailsCommand}"
                            ToolTip="清除队列后重新生成库内全部缩略图" />
                    <TextBlock Text="{Binding StatusBarText}" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding StatusBarText, Converter={StaticResource NullVis}}" />
                </StackPanel>
            </TabItem>

            <!-- ═══ A3 AI ═══ -->
            <TabItem Header="AI 分析">
                <StackPanel Margin="14,12">
                    <TextBlock Text="AI 分析模式" Style="{StaticResource SectionCaptionStyle}" />
                    <StackPanel Margin="0,6,0,0">
                        <RadioButton Content="关闭" GroupName="AiMode" Margin="0,2"
                                     IsChecked="{Binding SelectedAiMode, Converter={StaticResource EnumEq}, ConverterParameter=Disabled}" />
                        <RadioButton Content="本地模型（离线）" GroupName="AiMode" Margin="0,2"
                                     IsChecked="{Binding SelectedAiMode, Converter={StaticResource EnumEq}, ConverterParameter=Local}" />
                        <RadioButton Content="云端服务" GroupName="AiMode" Margin="0,2"
                                     IsChecked="{Binding SelectedAiMode, Converter={StaticResource EnumEq}, ConverterParameter=Cloud}" />
                    </StackPanel>

                    <!-- 云端配置 -->
                    <Border Margin="0,16,0,0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            IsEnabled="{Binding IsCloudSectionEnabled}">
                        <StackPanel>
                            <TextBlock Text="云端服务（OpenAI 兼容，仅 HTTPS）"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock Text="Base URL" Margin="0,8,0,2" />
                            <TextBox Text="{Binding CloudBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="模型名" Margin="0,8,0,2" />
                            <TextBox Text="{Binding CloudModelName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Embedding 模型（可选，留空则不生成向量）" Margin="0,8,0,2" />
                            <TextBox Text="{Binding CloudEmbeddingModelName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="API Key" Margin="0,8,0,2" />
                            <PasswordBox x:Name="CloudApiKeyBox"
                                         PasswordChanged="OnCloudApiKeyChanged" />
                            <TextBlock Text="{Binding HasCloudApiKey, Converter={StaticResource BoolText},
                                         ConverterParameter='已保存 API Key|未设置 API Key'}"
                                       Margin="0,4,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="测试连接" Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding TestCloudConnectionCommand}" />
                                <TextBlock Text="{Binding AiStatusText}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="⚠ 图片将上传至所选服务，请确认合规。"
                                       Margin="0,10,0,0" FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 本地 ONNX 模型 -->
                    <Border Margin="0,12,0,0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            IsEnabled="{Binding IsLocalSectionEnabled}">
                        <StackPanel>
                            <TextBlock Text="本地 ONNX 模型（离线）"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock Text="{Binding LocalModelStateText}"
                                       Margin="0,6,0,0" FontWeight="Bold" />
                            <ProgressBar Height="6" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding DownloadPercent, Mode=OneWay}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="下载模型" Command="{Binding DownloadModelCommand}"
                                        Padding="14,4" Margin="0,0,8,0" MinWidth="88" />
                                <Button Content="取消" Command="{Binding CancelDownloadCommand}"
                                        Padding="14,4" Margin="0,0,8,0" MinWidth="64" />
                                <Button Content="手动导入…" Command="{Binding SelectModelFileCommand}"
                                        Padding="14,4" Margin="0,0,8,0" MinWidth="96" />
                                <Button Content="删除模型" Command="{Binding DeleteModelCommand}"
                                        Padding="14,4" MinWidth="88" />
                            </StackPanel>
                            <TextBlock Text="{Binding LocalStatusText}"
                                       Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding LocalStatusText, Converter={StaticResource NullVis}}" />
                            <TextBlock Text="{Binding LocalModelInfoText}"
                                       Margin="0,8,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ A4 监控目录 ═══ -->
            <TabItem Header="监控">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="被监控的目录（文件变动自动入库）"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <ListBox Grid.Row="1" Margin="0,6,0,0"
                             ItemsSource="{Binding WatcherDirectories}"
                             SelectedItem="{Binding SelectedWatcherDirectory}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加目录…" Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding AddWatcherDirectoryCommand}" />
                        <Button Content="移除选中" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding RemoveWatcherDirectoryCommand}" />
                    </StackPanel>
                    <CheckBox Grid.Row="3" Content="发现新文件后自动导入"
                              Margin="0,12,0,0"
                              IsChecked="{Binding AutoImportOnWatch}" />
                </Grid>
            </TabItem>

            <!-- ═══ A5 关于 / 旧版导入 / 诊断 ═══ -->
            <TabItem Header="关于">
                <StackPanel Margin="14,12">
                    <TextBlock Text="千星汇图" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VersionText}" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <TextBlock Text="统计" Margin="0,16,0,0"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <TextBlock Text="{Binding StatisticsText}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <TextBlock Text="从旧版 Python 库导入" Margin="0,16,0,0"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <TextBlock Text="旧版库文件（ql_world.db）路径："
                               Margin="0,4,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding LegacyDbPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="开始导入" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RunLegacyImportCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LegacyStatusText}" Margin="0,6,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding LegacyStatusText, Converter={StaticResource NullVis}}" />

                    <TextBlock Text="诊断" Margin="0,16,0,0"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <Button Content="打开日志文件夹" Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding OpenLogsFolderCommand}" />
                </StackPanel>
            </TabItem>

            <!-- ═══ A6 贴图组规则 ═══ -->
            <TabItem Header="贴图组">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="文件名尾缀 → 贴图角色（尾缀不区分大小写，按目录+基名成组）"
                               Style="{StaticResource SectionCaptionStyle}" />
                    <ListBox Grid.Row="1" Margin="0,6,0,0"
                             ItemsSource="{Binding PbrRules.Rules}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,6,0"
                                             Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="尾缀模式" />
                                    <ComboBox Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.PbrRules.RoleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Role}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Display"
                                              AutomationProperties.Name="贴图角色" />
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                              IsChecked="{Binding Enabled}"
                                              Content="启用"
                                              AutomationProperties.Name="启用规则" />
                                    <Button Grid.Column="3" Content="✕" Width="28"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{Binding RemoveCommand}"
                                            AutomationProperties.Name="删除规则" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="＋ 添加规则" Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding PbrRules.AddRuleCommand}" />
                        <Button Content="保存并重建" Margin="8,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding PbrRules.SaveCommand}" />
                        <Button Content="仅重建" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding PbrRules.RescanCommand}" />
                        <Button Content="恢复默认" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding PbrRules.RestoreDefaultsCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding PbrRules.StatusText}" Margin="0,8,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding PbrRules.StatusText, Converter={StaticResource NullVis}}" />
                </Grid>
            </TabItem>

            <!-- ═══ A7 NAS 连接 (M5 N1-N6 + v0.2.1 主 NAS 标记) ═══ -->
            <TabItem Header="NAS 连接"
                     Visibility="{Binding IsNasManagementEnabled, Converter={StaticResource BoolVis}}">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- N1 连接列表 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAS 连接（WebDav + Smb + Sftp）"
                                   Style="{StaticResource SectionCaptionStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="＋ 新建" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding AddNasConnectionCommand}"
                                AutomationProperties.Name="新建 NAS 连接" />
                        <!-- M8-D: 添加分享链接（ShareLink 副库，匿名访问） -->
                        <Button Grid.Column="2" Content="🔗 分享链接" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding AddShareLinkCommand}"
                                AutomationProperties.Name="添加分享链接" />
                        <Button Grid.Column="3" Content="删除选中" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding DeleteNasConnectionCommand}"
                                AutomationProperties.Name="删除 NAS 连接" />
                    </Grid>
                    <ListBox Grid.Row="1" Margin="0,6,0,0" MinHeight="80"
                             ItemsSource="{Binding NasConnections}"
                             SelectedItem="{Binding SelectedNasConnection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★ 主 " FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsPrimary, Converter={StaticResource BoolVis}}" />
                                    <!-- M8-D: ShareLink 副库用 🔗 图标区分 -->
                                    <TextBlock Text="🔗 " FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsShareLink, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- N2-N5 详情表单（仅在选中时显示） -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Visibility="{Binding SelectedNasConnection, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <!-- N2 名称 -->
                            <TextBlock Text="名称" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Text="{Binding SelectedNasConnection.Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="NAS 连接名称" />

                            <!-- N3 协议 + 地址 + 端口 -->
                            <TextBlock Text="协议" Margin="0,10,0,2" />
                            <ComboBox Width="160" HorizontalAlignment="Left"
                                      ItemsSource="{Binding NasProtocolOptions}"
                                      SelectedItem="{Binding SelectedNasConnection.Protocol}"
                                      SelectionChanged="OnNasProtocolChanged"
                                      AutomationProperties.Name="NAS 协议" />
                            <TextBlock Text="主机（IP 或域名，不含 scheme/port）" Margin="0,10,0,2" />
                            <TextBox Text="{Binding SelectedNasConnection.Host, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="NAS 主机" />
                            <TextBlock Text="{Binding NasPortHintText}" Margin="0,10,0,2" />
                            <TextBox Text="{Binding SelectedNasConnection.Port, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="NAS 端口" />

                            <!-- N4 用户名 + 密码 -->
                            <TextBlock Text="{Binding NasUsernameHintText}" Margin="0,10,0,2" />
                            <TextBox Text="{Binding SelectedNasConnection.Username, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="NAS 用户名" />
                            <TextBlock Text="密码（留空=不修改已保存密码）" Margin="0,10,0,2" />
                            <PasswordBox x:Name="NasPasswordBox"
                                         PasswordChanged="OnNasPasswordChanged"
                                         AutomationProperties.Name="NAS 密码" />

                            <!-- N5 根路径 + TLS + 自签 -->
                            <TextBlock Text="{Binding NasRootPathHint}" Margin="0,10,0,2" />
                            <TextBox Text="{Binding SelectedNasConnection.RootPath, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="NAS 根路径" />
                            <CheckBox Content="{Binding NasTlsLabelText}" Margin="0,10,0,0"
                                      IsChecked="{Binding SelectedNasConnection.UseTls}"
                                      Visibility="{Binding IsTlsApplicable, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="NAS 启用 TLS" />
                            <CheckBox Content="{Binding NasTrustLabelText}" Margin="0,4,0,0"
                                      IsChecked="{Binding SelectedNasConnection.TrustSelfSigned}"
                                      Visibility="{Binding IsTrustSelfSignedApplicable, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="NAS 信任自签" />

                            <!-- N6 测试连接 + 设为主 NAS（仅切标记）+ 保存 -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="测试连接" Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding TestNasConnectionCommand}"
                                        AutomationProperties.Name="测试 NAS 连接" />
                                <Button Content="设为主 NAS（仅切标记）" Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding SetPrimaryCommand}"
                                        AutomationProperties.Name="设为主 NAS 仅切标记" />
                                <Button Content="保存" Margin="8,0,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding SaveNasConnectionCommand}"
                                        AutomationProperties.Name="保存 NAS 连接" />
                            </StackPanel>

                            <!-- M8-E: 主 NAS 迁移 + 搬运到此处（仅管理员可见） -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="设为主 NAS 并迁移数据" Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding SetPrimaryWithMigrationCommand}"
                                        ToolTip="把当前主库的全部数据复制到选中副库，复制成功后切换主库角色。失败可重试（幂等）。"
                                        AutomationProperties.Name="设为主 NAS 并迁移数据" />
                                <Button Content="搬运到此处..." Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding TransferToHereCommand}"
                                        ToolTip="数据搬运流程入口（在共享画廊选中图片后右键搬运到副库）"
                                        AutomationProperties.Name="搬运到此处" />
                            </StackPanel>

                            <!-- M8-E: 迁移进度文案 -->
                            <TextBlock Text="{Binding MigrationStatusText}" Margin="0,8,0,0" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding MigrationStatusText, Converter={StaticResource NullVis}}" />

                            <!-- M8-E: 显示数据来源徽章开关 -->
                            <CheckBox Content="在共享画廊显示数据来源徽章（nas://{id}）" Margin="0,14,0,0"
                                      IsChecked="{Binding ShowSourceBadge}"
                                      ToolTip="开启后每张共享图带 nas:// 来源标识，便于管理员区分主副库数据"
                                      AutomationProperties.Name="显示数据来源徽章" />

                            <TextBlock Text="{Binding NasStatusText}" Margin="0,8,0,0" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding NasStatusText, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ A7 用户管理（M6-C，仅管理员）═══ -->
            <TabItem Header="用户管理"
                     Visibility="{Binding IsUserManagementEnabled, Converter={StaticResource BoolVis}}">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 账号列表 + 刷新 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="账号列表"
                                   Style="{StaticResource SectionCaptionStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="刷新"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding RefreshAccountsCommand}" />
                    </Grid>

                    <ListBox Grid.Row="1" Margin="0,6,0,0" MinHeight="120"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Username}" Width="120"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Role}" Width="60"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 选中账号操作 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding SelectedAccount, Converter={StaticResource NullVis}}">
                        <Button Content="启用/禁用"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding ToggleUserStatusCommand}" />
                        <Button Content="重置密码" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding ResetPasswordCommand}" />
                        <Button Content="删除" Margin="8,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding DeleteUserCommand}" />
                    </StackPanel>

                    <!-- 新建用户表单 -->
                    <Border Grid.Row="2" Margin="0,50,0,0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="新建用户" Style="{StaticResource SectionCaptionStyle}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0"
                                         Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="新建用户名" />
                                <TextBox Grid.Column="1" Margin="4,0,4,0"
                                         Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="新建用户密码" />
                                <Button Grid.Column="2" Content="添加"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding AddUserCommand}" />
                            </Grid>
                            <CheckBox Content="设为管理员" Margin="0,6,0,0"
                                      IsChecked="{Binding NewUserIsAdmin}" />
                            <TextBlock Text="{Binding UserManagementStatus}" Margin="0,6,0,0"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding UserManagementStatus, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Padding="12,8"
                Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Button Content="关闭" Width="96" HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButtonStyle}"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />
        </Border>
    </Grid>
</Window>
