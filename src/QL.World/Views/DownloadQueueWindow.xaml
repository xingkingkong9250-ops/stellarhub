<Window x:Class="QL.World.Views.DownloadQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:QL.World.Views.Converters"
        mc:Ignorable="d"
        Width="600" Height="400"
        MinWidth="520" MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Title="下载队列 — 千星汇图">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="14,12,14,4"
                   Text="下载队列" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <ListView Grid.Row="1" Margin="12,0,12,8"
                  ItemsSource="{Binding Items}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- D1 文件名 -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FileName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   ToolTip="{Binding FileName}" />
                        <!-- D2 进度条 -->
                        <ProgressBar Grid.Column="1" Height="14" Margin="8,0"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}" />
                        <!-- D3 状态 -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <!-- D4 操作按钮 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="取消"
                                    Width="56" Padding="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}" />
                            <Button Content="重试"
                                    Width="56" Margin="4,0,0,0" Padding="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}" />
                            <Button Content="打开目录"
                                    Width="72" Margin="4,0,0,0" Padding="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                        <!-- 错误提示（仅失败时显示） -->
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                                   Margin="0,18,0,0"
                                   Text="{Binding Error}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="1" Text="队列为空"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{DynamicResource TextMutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2" Padding="12,8"
                Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Button Content="关闭" Width="96" HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButtonStyle}"
                    IsCancel="True" />
        </Border>
    </Grid>
</Window>
