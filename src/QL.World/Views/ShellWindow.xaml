<Window x:Class="QL.World.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:support="clr-namespace:QL.World.Views.Support"
        xmlns:conv="clr-namespace:QL.World.Views.Converters"
        xmlns:controls="clr-namespace:QL.World.Views.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:Width="1400" d:Height="850"
        Width="1400" Height="850"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{Binding Title}">

    <WindowChrome.WindowChrome>
        <!-- v0.6.2: 合并系统标题栏与 Row 0 菜单行；Windows 自动在右侧绘制
             最小化/最大化/关闭三按钮，无需自定义按钮逻辑。 -->
        <WindowChrome CaptionHeight="40"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <x:Array x:Key="RatingSteps" Type="{x:Type sys:Int32}">
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
        </x:Array>

        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroVis" />
        <conv:NumericThresholdConverter x:Key="Threshold" />
        <conv:RatingStarBrushConverter x:Key="StarBrush" />
        <conv:HexBrushConverter x:Key="HexBrush" />
        <!-- v0.13.0: bool → GridLength（B1 左栏宽度 / B3 详情栏宽度动态切换） -->
        <conv:BoolToGridLengthConverter x:Key="BoolGridLen" />

        <!-- v0.6.2: 自定义窗口 caption 按钮（替代 UseAeroCaptionButtons，Windows 11 上更稳定） -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" TargetName="bg" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- F-04: responsive top bar — icon-only / shrunken controls under 1500 logical px -->
        <Style x:Key="CompactScanButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Content" Value="📡 扫描 NAS" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="📡" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A1-10 (v0.8.0): manual refresh — rescan watched dirs + reload gallery (F5). -->
        <Style x:Key="CompactRefreshButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Content" Value="🔄 刷新" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="🔄" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactDownloadButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Content" Value="📥 下载队列" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="📥" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactReviewButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Content" Value="🛡 审核队列" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="🛡" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- F-04 (extended): the remaining text buttons on the left also
             collapse to icons so the two sides never overlap. -->
        <Style x:Key="CompactImportButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Content" Value="＋ 导入图片" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="＋" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactAiButton" TargetType="Button" BasedOn="{StaticResource AiButtonStyle}">
            <Setter Property="Content" Value="AI 分析" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="🤖" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactColorButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Content" Value="分析颜色" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Content" Value="🎨" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Local/shared scope toggles: text → single glyph.
             A Setter.Value cannot be a Binding, so swap the ContentTemplate
             (a DataTemplate is allowed inside a setter) and bind it to Tag. -->
        <Style x:Key="CompactScopeToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Grid/list view toggles: drop the Chinese word, keep the glyph from Tag. -->
        <Style x:Key="CompactViewToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Build/version annotation is non-essential chrome. -->
        <Style x:Key="CompactVersionText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactHidePanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="240" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Threshold}, ConverterParameter=1500}" Value="True">
                    <Setter Property="Width" Value="140" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- U3-A (§4.B.2): B1-5 attribute filter chip — accent when active -->
        <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentDimBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- M12-F (v0.13.0): B1-1 tree expander arrow (▸ collapsed / ▾ expanded) -->
        <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="arrow" Text="▸"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="Text" Value="▾" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v0.13.3: B1-1 二级分类标签气泡 chip（WrapPanel 自动换行，节省纵向空间；
             视觉对齐 B1-5 属性筛选气泡：圆角 8、未选描边、选中 Accent 填充） -->
        <Style x:Key="TreeTagChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentBgBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M12-F: B1-6-3 色板色块 — 22×22 方块，激活态 Accent 描边 -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="2"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                Background="{Binding Brush}" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M12-F: B1-6 筛选标签组模板（组名 + 多选 chips WrapPanel） -->
        <DataTemplate x:Key="FilterGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding GroupName}" Margin="2,2,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FilterChipStyle}"
                                    Content="{Binding Tag}"
                                    Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- U3-B (§4.C.1): B2-3-ACT hover action button on the thumbnail overlay -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnOverlayBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- B2 grid card -->
        <DataTemplate x:Key="GridCardTemplate">
            <Border Margin="4" Padding="6"
                    Background="{DynamicResource SurfaceVariantBrush}"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <!-- B2-3-SEL：选中态 2px Accent 外描边（不改底色，底色由 ListBoxItem AccentBg 提供） -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Width="{Binding DataContext.GridZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.GridZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- U2-D (§4.C.2): B2-3-OL1 source badge (本地/云端/AI) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,4,4" Padding="4,1" CornerRadius="3"
                                    Background="{DynamicResource OverlayBrush}"
                                    Visibility="{Binding SourceBadge, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SourceBadge}" FontSize="10"
                                           Foreground="{DynamicResource TextOnOverlayBrush}" />
                            </Border>
                            <!-- U3-B (§4.C.1): B2-3-ACT hover action bar (打开/定位/复制路径)。
                                 默认 Collapsed 不参与 Measure（虚拟化安全）；作用于悬停卡片而非当前选中。 -->
                            <Border VerticalAlignment="Bottom" Padding="4,2"
                                    Background="{DynamicResource OverlayBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Content="↗" ToolTip="打开原文件"
                                            Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Content="⌖" ToolTip="在资源管理器中定位"
                                            Command="{Binding DataContext.RevealItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Content="⧉" ToolTip="复制路径"
                                            Command="{Binding DataContext.CopyItemPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="2,6,2,0">
                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DimensionsText}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding Rating, StringFormat='★{0}'}"
                                       Visibility="{Binding Rating, Converter={StaticResource ZeroVis}, ConverterParameter=Invert}" />
                        </Grid>
                        <!-- U2-E (§4.D.1): tag summary row (first 2 + +N); hidden when no tags -->
                        <TextBlock Text="{Binding TagsSummary}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TagsSummary, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                    <Border Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="文件缺失" Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- B2 list row -->
        <DataTemplate x:Key="ListRowTemplate">
            <Border Height="{Binding DataContext.ListRowHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <!-- B2-3-SEL 列表态：左 3px Accent 竖条 + 底线；Padding 同步减 3px 抵消 layout shift -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="3,0,0,1" />
                                <Setter Property="Padding" Value="5,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="{Binding DataContext.ListZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.ListZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource SurfaceVariantBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                            <!-- U2-D (§4.C.2): B2-3-OL1 source badge (本地/云端/AI) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,3,3,0" Padding="3,0" CornerRadius="2"
                                    Background="{DynamicResource OverlayBrush}"
                                    Visibility="{Binding SourceBadge, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SourceBadge}" FontSize="9"
                                           Foreground="{DynamicResource TextOnOverlayBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding TagsCsv}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding DimensionsText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                               Text="{Binding CategoryText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                               Text="{Binding FileSizeText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding Rating, StringFormat='★{0}'}" />
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanelTemplate">
            <support:VirtualizingTilePanel
                ItemWidth="{Binding DataContext.GridCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                ItemHeight="{Binding DataContext.GridCardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <!-- B2-3-BRW: minimal-text masonry card. Image-only by default; on hover
             a bottom gradient reveals file name + rating + source badge
             (ArtStation-style). No permanent chips / no action buttons. -->
        <DataTemplate x:Key="BrowseCardTemplate">
            <Border Margin="4" CornerRadius="6" ClipToBounds="True"
                    Background="{DynamicResource SurfaceVariantBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Hover overlay: bottom gradient with file name + rating + source badge -->
                    <Border VerticalAlignment="Bottom">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="0.45" Color="#A6000000" />
                                            <GradientStop Offset="1" Color="#E6000000" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Rating chip (only when rated > 0) -->
                                <Border Margin="0,0,6,0" Padding="4,1" CornerRadius="3"
                                        Background="#33000000"
                                        Visibility="{Binding Rating, Converter={StaticResource ZeroVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Rating, StringFormat='★{0}'}" FontSize="11"
                                               Foreground="{DynamicResource AccentDimBrush}" />
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontSize="11"
                                           Foreground="{DynamicResource TextOnOverlayBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Source badge (only when present) -->
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#33000000"
                                    Visibility="{Binding SourceBadge, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SourceBadge}" FontSize="10"
                                           Foreground="{DynamicResource TextOnOverlayBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Missing file overlay (always visible when IsMissing) -->
                    <Border Background="{DynamicResource OverlayBrush}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="文件缺失" Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="BrowsePanelTemplate">
            <support:VirtualizingMasonryPanel
                ItemWidth="{Binding DataContext.BrowseCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding TopBar.ImportCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="5" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════ A1-M Row 1: 菜单行（VS Code 风格 — 品牌 + 文本菜单栏 + 右侧系统区） ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：品牌 Logo + 名称（v0.7.0 品牌图：星光相框猫） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{StaticResource BrandLogoSource}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="千星汇图" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 中部：文本菜单栏（文件 / 视图 / 工具 / 帮助）— A1-M -->
                <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center"
                      IsMainMenu="True" Margin="6,0,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="导入图片…" Command="{Binding TopBar.ImportCommand}"
                                  InputGestureText="Ctrl+I" />
                        <MenuItem Header="扫描 NAS 库…" Command="{Binding ScanNasLibraryCommand}" />
                        <MenuItem Header="下载队列…" Command="{Binding ShowDownloadQueueCommand}" />
                    </MenuItem>
                    <MenuItem Header="视图(_V)">
                        <MenuItem Header="网格视图" IsCheckable="True"
                                  IsChecked="{Binding TopBar.IsGridView, Mode=TwoWay}"
                                  InputGestureText="▦" />
                        <MenuItem Header="列表视图" IsCheckable="True"
                                  IsChecked="{Binding Gallery.IsListView, Mode=TwoWay}"
                                  InputGestureText="≡" />
                        <MenuItem Header="浏览视图（瀑布流）" IsCheckable="True"
                                  IsChecked="{Binding TopBar.IsBrowseView, Mode=TwoWay}"
                                  InputGestureText="⊞" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}"
                                   Visibility="{Binding IsSharedLibraryAvailable, Converter={StaticResource BoolVis}}" />
                        <MenuItem Header="本地库" IsCheckable="True"
                                  IsChecked="{Binding IsLocalScope, Mode=TwoWay}"
                                  Visibility="{Binding IsSharedLibraryAvailable, Converter={StaticResource BoolVis}}" />
                        <MenuItem Header="共享库"
                                  Command="{Binding SwitchToSharedCommand}"
                                  Visibility="{Binding IsSharedLibraryAvailable, Converter={StaticResource BoolVis}}" />
                    </MenuItem>
                    <MenuItem Header="工具(_T)">
                        <MenuItem Header="AI 分析" Command="{Binding TopBar.AiCommand}"
                                  ToolTip="{Binding TopBar.AiDisabledReason}" />
                        <MenuItem Header="分析颜色（批量回填）" Command="{Binding TopBar.ColorCommand}" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="审核队列…" Command="{Binding ShowReviewQueueCommand}"
                                  Visibility="{Binding IsReviewAvailable, Converter={StaticResource BoolVis}}" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}"
                                   Visibility="{Binding IsReviewAvailable, Converter={StaticResource BoolVis}}" />
                        <MenuItem Header="设置…" Command="{Binding TopBar.SettingsCommand}" />
                    </MenuItem>
                    <MenuItem Header="帮助(_H)">
                        <MenuItem Header="关于 / 版本信息" Command="{Binding TopBar.SettingsCommand}" />
                        <MenuItem Header="打开日志文件夹" Command="{Binding TopBar.SettingsCommand}" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="快捷键提示" IsEnabled="False"
                                  ToolTip="见状态栏右下角上下文提示" />
                    </MenuItem>
                </Menu>

                <!-- 右侧：通知 + 设置 + 版本号 + 自定义系统三按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="0,0,6,0">
                        <Button x:Name="NotificationsButton" Style="{StaticResource SubtleButtonStyle}" Content="🔔"
                                ToolTip="消息中心"
                                Command="{Binding TopBar.NotificationsCommand}" />
                        <Ellipse Width="9" Height="9"
                                 Fill="{DynamicResource WarningBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0"
                                 Visibility="{Binding TopBar.Notifications.HasUnreadBadge, Converter={StaticResource BoolVis}}" />
                        <Popup PlacementTarget="{Binding ElementName=NotificationsButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding TopBar.Notifications.IsPopupOpen, Mode=TwoWay}">
                            <Border Width="340" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="消息中心" FontWeight="Bold" Margin="2,0,0,6"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ListBox Grid.Row="1" MaxHeight="360" MinHeight="48"
                                             ItemsSource="{Binding TopBar.Notifications.Items}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{DynamicResource WarningBrush}"
                                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolVis}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                               MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CreatedAtText}" FontSize="10" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="1" Text="暂无消息" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="12" Margin="0,14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding TopBar.Notifications.Items.Count, Converter={StaticResource ZeroVis}}" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Content="全部已读"
                                                Command="{Binding TopBar.Notifications.MarkAllReadCommand}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}" Content="清空" Margin="6,0,0,0"
                                                Command="{Binding TopBar.Notifications.ClearAllCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="⚙" Margin="6,0,0,0"
                            ToolTip="设置"
                            Command="{Binding TopBar.SettingsCommand}" />
                    <TextBlock Text="{Binding VersionText}" Margin="10,0,0,0" Style="{StaticResource CompactVersionText}"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <!-- v0.6.2: 自定义 caption 三按钮（替代系统 AeroCaptionButtons） -->
                    <Button Style="{StaticResource CaptionButton}" Content="—" Margin="8,0,0,0"
                            ToolTip="最小化" Click="OnMinimize" />
                    <Button Style="{StaticResource CaptionButton}" Content="▢"
                            ToolTip="最大化/还原" Click="OnMaximize" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="✕"
                            ToolTip="关闭" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ A1-T Row 2: 工具条行（操作按钮 + 搜索 + 视图切换） ═══════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：操作工具条 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CompactImportButton}"
                            Command="{Binding TopBar.ImportCommand}" />
                    <!-- M5-D N7: scan a NAS library (remote import). -->
                    <Button Margin="8,0,0,0" Style="{StaticResource CompactScanButton}"
                            ToolTip="扫描已配置的 NAS 连接目录，索引为远程图片"
                            AutomationProperties.Name="扫描NAS"
                            Command="{Binding ScanNasLibraryCommand}" />
                    <!-- A1-10 (v0.8.0): manual refresh — rescan watched dirs + reload gallery (F5). -->
                    <Button Margin="8,0,0,0" Style="{StaticResource CompactRefreshButton}"
                            ToolTip="重新扫描监控目录并刷新画廊数据（F5）"
                            AutomationProperties.Name="刷新数据"
                            Command="{Binding RefreshCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource CompactAiButton}"
                            ToolTip="{Binding TopBar.AiDisabledReason}"
                            Command="{Binding TopBar.AiCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource CompactColorButton}"
                            ToolTip="为缺失主色调的图片批量回填 dominant_colors"
                            Command="{Binding TopBar.ColorCommand}" />
                    <!-- M5-G: open the persistent download queue window. -->
                    <Button Margin="8,0,0,0" Style="{StaticResource CompactDownloadButton}"
                            ToolTip="打开下载队列（NAS→本地，支持续传/重试）"
                            AutomationProperties.Name="下载队列"
                            Command="{Binding ShowDownloadQueueCommand}" />
                    <!-- U6-C: 管理员审核队列入口（含 pending 角标） -->
                    <Grid Margin="8,0,0,0"
                          Visibility="{Binding IsReviewAvailable, Converter={StaticResource BoolVis}}">
                        <Button x:Name="ReviewQueueButton" Style="{StaticResource CompactReviewButton}"
                                ToolTip="审核用户提交到共享库的图片"
                                AutomationProperties.Name="审核队列"
                                Command="{Binding ShowReviewQueueCommand}" />
                        <Border MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0" CornerRadius="8"
                                Background="{DynamicResource WarningBrush}"
                                Visibility="{Binding PendingCount, Converter={StaticResource ZeroVis}, ConverterParameter=Invert}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnWarningBrush}"
                                       Text="{Binding PendingCount}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 中部：搜索框 + 搜索模式 + 最近入库 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource CompactSearchBox}" Height="30"
                             AutomationProperties.Name="SearchBox"
                             VerticalContentAlignment="Center"
                             Text="{Binding TopBar.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索（300ms 防抖）" />
                    <ComboBox Width="118" Margin="8,0,0,0"
                              ItemsSource="{Binding TopBar.SearchModes}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding TopBar.SelectedSearchMode}" />
                    <!-- U2-B: 最近入库 dropdown (collapsed under 1500px) -->
                    <StackPanel Style="{StaticResource CompactHidePanel}" Orientation="Horizontal">
                        <ComboBox Width="110" Margin="8,0,0,0"
                                  ItemsSource="{Binding TopBar.RecentImportOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Days"
                                  SelectedValue="{Binding TopBar.SelectedRecentImport}"
                                  ToolTip="按入库时间筛选" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：本地/共享库切换（v0.12.3：视图切换三按钮迁移至 B2 工具条左侧） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- U6-A B1-SCOPE: 本地库/共享库切换（仅 NAS 登录可见） -->
                    <ToggleButton Style="{StaticResource CompactScopeToggle}"
                                  IsChecked="{Binding IsLocalScope}"
                                  Content="本地库" Tag="💻" ToolTip="本地图片库"
                                  Visibility="{Binding IsSharedLibraryAvailable, Converter={StaticResource BoolVis}}" />
                    <ToggleButton Style="{StaticResource CompactScopeToggle}" Margin="4,0,0,0"
                                  IsChecked="{Binding IsSharedScope, Mode=OneWay}"
                                  Command="{Binding SwitchToSharedCommand}"
                                  Content="共享库" Tag="☁️" ToolTip="NAS 共享图库"
                                  Visibility="{Binding IsSharedLibraryAvailable, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ B 主分区 ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- v0.13.0: B1 左栏宽度随 IsSidebarTextMode 切换：文字模式 240 / 图标模式 60 -->
                <ColumnDefinition Width="{Binding IsSidebarTextMode, Converter={StaticResource BoolGridLen}, ConverterParameter='240,60'}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- v0.13.0: B3 详情栏宽度随 IsDetailPanelExpanded 切换：展开 300 / 折叠 40 -->
                <ColumnDefinition Width="{Binding IsDetailPanelExpanded, Converter={StaticResource BoolGridLen}, ConverterParameter='300,40'}" />
            </Grid.ColumnDefinitions>

            <!-- ─── B1 左栏 ─── -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- v0.13.0: 顶部模式切换按钮（图标/文字），始终显示。
                         图标模式显示 »（展开为文字模式），文字模式显示 «（收起为图标模式） -->
                    <Button DockPanel.Dock="Top" Height="32" Margin="2"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding ToggleSidebarModeCommand}">
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="收起侧栏（当前文字模式）" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarIconMode}" Value="True">
                                                <Setter Property="Text" Value="展开侧栏（当前图标模式）" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconCollapse}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarIconMode}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconExpand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- ═══ 图标模式（约 60px）：漏斗筛选 + 分类图标 ═══ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4"
                                  Visibility="{Binding IsSidebarIconMode, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <!-- 漏斗筛选按钮 + Popup（承载 B1-6 全部筛选组） -->
                            <ToggleButton x:Name="FilterPopupToggle" Margin="0,0,0,6"
                                          HorizontalAlignment="Center"
                                          Style="{StaticResource SubtleToggleButtonStyle}"
                                          Width="40" Height="40"
                                          ToolTip="筛选标签组">
                                <Path Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      Data="{StaticResource IconFilter}" />
                                <ToggleButton.ContextMenu>
                                    <ContextMenu />
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=FilterPopupToggle}"
                                   Placement="Right" HorizontalOffset="4" VerticalOffset="-32"
                                   IsOpen="{Binding IsChecked, ElementName=FilterPopupToggle, Mode=TwoWay}"
                                   StaysOpen="False"
                                   PopupAnimation="Slide">
                                <Border Width="280" MaxHeight="600"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="筛选标签组" Style="{StaticResource SectionCaptionStyle}" />
                                            <!-- B1-6-1 美术风格 / B1-6-2 文件格式 -->
                                            <ItemsControl ItemsSource="{Binding FilterGroups.GroupsBeforePalette}"
                                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                                            <!-- B1-6-3 色彩倾向 -->
                                            <TextBlock Text="色彩倾向" Margin="2,2,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding FilterGroups.Palette.Swatches}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ColorSwatchStyle}"
                                                                Command="{Binding SelectCommand}"
                                                                ToolTip="{Binding Hex}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- B1-6-4..7 / B1-6-11 -->
                                            <ItemsControl ItemsSource="{Binding FilterGroups.GroupsAfterPalette}"
                                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                                            <!-- B1-6-8 分辨率 / B1-6-9 大小 / B1-6-10 评分 -->
                                            <ItemsControl ItemsSource="{Binding FilterGroups.AttributeGroups}"
                                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <!-- 分类图标列表（垂直） -->
                            <ItemsControl ItemsSource="{Binding TagTree.CategoryNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton HorizontalAlignment="Center"
                                                      Width="40" Height="40" Margin="0,2"
                                                      Style="{StaticResource SubtleToggleButtonStyle}"
                                                      AutomationProperties.Name="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding SelectCommand}">
                                            <ToggleButton.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text=" (" />
                                                    <TextBlock Text="{Binding Count}" />
                                                    <TextBlock Text=")" />
                                                </StackPanel>
                                            </ToggleButton.ToolTip>
                                            <Path Width="22" Height="22" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                                  Data="{Binding IconGeometry}" />
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ 文字模式（约 240px）：完整分类树 + 筛选组 ═══ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,8,12"
                                  Visibility="{Binding IsSidebarTextMode, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <!-- U3-C (§4.E.3): B1-COL 分区标题可折叠，折叠态显示子项数 (N) -->
                        <ToggleButton Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="素材库"
                                      IsChecked="{Binding SidebarLibraryExpanded}"
                                      Content="{Binding LibraryHeaderText}" />
                        <!-- M12-F (v0.13.0): B1-1 树改为 6 个新分类，可展开显示该分类的
                             标签作为二级节点；点击分类行筛选 primary_category，
                             点击二级标签按单标签筛选（Filter.Tag） -->
                        <ItemsControl ItemsSource="{Binding TagTree.CategoryNodes}"
                                      Visibility="{Binding SidebarLibraryExpanded, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="0"
                                                          Style="{StaticResource TreeExpanderStyle}"
                                                          IsChecked="{Binding IsExpanded}"
                                                          Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}" />
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource TreeToggleStyle}"
                                                          AutomationProperties.Name="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          Command="{Binding SelectCommand}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding Count}" />
                                                </Grid>
                                            </ToggleButton>
                                        </Grid>
                                        <!-- 二级标签节点（分类组词表）：v0.13.3 起改气泡 chips
                                             WrapPanel 自动换行，替代整行纵列以节省空间 -->
                                        <ItemsControl Margin="22,2,0,4"
                                                      ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource TreeTagChipStyle}"
                                                                  AutomationProperties.Name="{Binding Tag}"
                                                                  IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                  Command="{Binding SelectCommand}">
                                                        <TextBlock Text="{Binding Tag}" />
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="2,8,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource ChipActiveButtonStyle}"
                                Content="✕ 清除全部筛选"
                                Visibility="{Binding Gallery.FilterSummary, Converter={StaticResource NullVis}}"
                                Command="{Binding ClearFiltersCommand}" />

                        <!-- v0.13.6: B1-2 收藏夹分区暂隐藏（功能预留，VM/服务层与折叠态
                             持久化全部保留）；恢复时删除下方两处 Visibility="Collapsed"，
                             内容面板还原为 BoolVis 绑定 SidebarCollectionsExpanded -->
                        <ToggleButton Margin="2,16,0,0"
                                      Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="收藏夹"
                                      IsChecked="{Binding SidebarCollectionsExpanded}"
                                      Content="{Binding CollectionsHeaderText}"
                                      Visibility="Collapsed" />
                        <StackPanel Visibility="Collapsed">
                            <Button Content="＋ 新建" Style="{StaticResource ChipActiveButtonStyle}"
                                    Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Command="{Binding CreateCollectionCommand}" />
                            <ItemsControl ItemsSource="{Binding CollectionTree.CollectionNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TreeToggleStyle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  AllowDrop="True"
                                                  Drop="OnCollectionDrop">
                                        <ToggleButton.ContextMenu>
                                            <!-- F-12: Popup 树中不存在 Window 祖先，AncestorType=Window 绑定必然静默失败；
                                                 改经 ContextMenu.PlacementTarget（ToggleButton，Tag=ShellViewModel）寻址 -->
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="重命名…"
                                                          Command="{Binding DataContext.RenameCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="删除…"
                                                          Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="设为封面（当前所选）"
                                                          Command="{Binding DataContext.SetCollectionCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </ToggleButton.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Count}" />
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- v0.13.6: B1-3 热门标签 Top50 暂隐藏（功能预留）；恢复时删除
                             两处 Visibility="Collapsed"，ItemsControl 还原为 BoolVis
                             绑定 SidebarTopTagsExpanded -->
                        <ToggleButton Margin="2,16,0,0"
                                      Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="热门标签"
                                      IsChecked="{Binding SidebarTopTagsExpanded}"
                                      Content="{Binding TopTagsHeaderText}"
                                      Visibility="Collapsed" />
                        <ItemsControl Margin="2,0,0,0"
                                      ItemsSource="{Binding TagTree.TopTagNodes}"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButtonStyle}"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="#" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Tag}" Margin="2,0,0,0" />
                                            <TextBlock Text="{Binding Count, StringFormat=' {0}'}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- v0.13.6: B1-4 贴图组分区暂隐藏（功能预留，PBR 组服务与
                             W3/A6 规则页不受影响）；恢复时删除两处
                             Visibility="Collapsed"，ItemsControl 还原为 BoolVis
                             绑定 SidebarPbrGroupsExpanded -->
                        <ToggleButton Margin="2,16,0,0"
                                      Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="贴图组"
                                      IsChecked="{Binding SidebarPbrGroupsExpanded}"
                                      Content="{Binding PbrGroupsHeaderText}"
                                      Visibility="Collapsed" />
                        <ItemsControl ItemsSource="{Binding PbrGroupTree.GroupNodes}"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TreeToggleStyle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding MemberCount}" />
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- v0.13.5: 原 B1-5「属性筛选」分区整体作废——颜色（v0.13.4）、
                             分辨率/文件大小/评分（v0.13.5）全部并入 B1-6 筛选标签组，
                             B1-5 及 B1-5-1~4 编号作废永不复用。 -->

                        <!-- M12-F (v0.13.0) / v0.13.5 / v0.13.7: B1-6 筛选标签组（默认收起，折叠态持久化）。
                             11 个子项：美术风格/文件格式（chips）→ 色彩倾向（色板）→
                             画面构图/灯光氛围/题材气质/状态形容/质感（chips；质感 v0.13.7
                             自 B1-1 移入，编号 B1-6-11）→
                             分辨率/文件大小/评分（单选桶 chips，原 B1-5）；
                             组内 OR、组间 AND（LibraryFilter 各字段） -->
                        <ToggleButton Margin="2,16,0,0"
                                      Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="筛选标签组"
                                      IsChecked="{Binding FilterGroups.IsExpanded}"
                                      Content="筛选标签组" />
                        <StackPanel Margin="2,0,0,0"
                                    Visibility="{Binding FilterGroups.IsExpanded, Converter={StaticResource BoolVis}}">
                            <!-- B1-6-1 美术风格 / B1-6-2 文件格式 -->
                            <ItemsControl ItemsSource="{Binding FilterGroups.GroupsBeforePalette}"
                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                            <!-- B1-6-3 色彩倾向（色板多选） -->
                            <TextBlock Text="色彩倾向" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding FilterGroups.Palette.Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColorSwatchStyle}"
                                                Command="{Binding SelectCommand}"
                                                ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- B1-6-4 画面构图 / B1-6-5 灯光氛围 / B1-6-6 题材气质 /
                                 B1-6-7 状态形容 / B1-6-11 质感（v0.13.7 自 B1-1 移入；
                                 编号顺延 11，视觉位于属性桶之前） -->
                            <ItemsControl ItemsSource="{Binding FilterGroups.GroupsAfterPalette}"
                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                            <!-- B1-6-8 分辨率（长边）/ B1-6-9 文件大小 / B1-6-10 评分（单选桶，原 B1-5-2/3/4） -->
                            <ItemsControl ItemsSource="{Binding FilterGroups.AttributeGroups}"
                                          ItemTemplate="{StaticResource FilterGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ─── B2 画廊 ─── -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <DockPanel>
                    <!-- B2 toolbar -->
                    <Grid DockPanel.Dock="Top" Height="40" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- W1/A1-3 视图切换三态（v0.12.3：从顶部 Row 1 工具条右侧迁移至此，
                                 显示计数移至 C1-C 状态栏居中区，本处仅保留视图切换+筛选摘要；
                                 v0.12.3 起瀑布流（默认）置首位） -->
                            <!-- B2-3-BRW: 浏览（瀑布流）— 图片为主、极少文本；v0.12.3 起为默认视图 -->
                            <ToggleButton Style="{StaticResource CompactViewToggle}"
                                          IsChecked="{Binding TopBar.IsBrowseView}"
                                          Content="⊞ 浏览" Tag="⊞" ToolTip="浏览视图（瀑布流）" />
                            <ToggleButton Style="{StaticResource CompactViewToggle}" Margin="4,0,0,0"
                                          IsChecked="{Binding TopBar.IsGridView}"
                                          Content="▦ 网格" Tag="▦" ToolTip="网格视图" />
                            <ToggleButton Style="{StaticResource CompactViewToggle}" Margin="4,0,0,0"
                                          IsChecked="{Binding Gallery.IsListView}"
                                          Content="≡ 列表" Tag="≡" ToolTip="列表视图" />
                            <Border Background="{DynamicResource BorderSubtleBrush}"
                                    Width="1" Height="16" Margin="10,0" />
                            <TextBlock Text="{Binding Gallery.FilterSummary}" FontSize="12"
                                       Foreground="{DynamicResource AccentDimBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Gallery.FilterSummary, Converter={StaticResource NullVis}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- B2-4 zoom (grid) -->
                            <Slider x:Name="GridZoomSlider" Width="120" Minimum="80" Maximum="512"
                                    TickFrequency="8" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Gallery.IsGridView, Converter={StaticResource BoolVis}}" />
                            <!-- B2-4 zoom (list) -->
                            <Slider x:Name="ListZoomSlider" Width="120" Minimum="80" Maximum="512"
                                    TickFrequency="8" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Gallery.IsListView, Converter={StaticResource BoolVis}}" />
                            <!-- B2-4-BRW zoom (browse masonry width) -->
                            <Slider x:Name="BrowseZoomSlider" Width="120" Minimum="160" Maximum="512"
                                    TickFrequency="8" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Gallery.IsBrowseView, Converter={StaticResource BoolVis}}" />
                            <Border Background="{DynamicResource BorderSubtleBrush}"
                                    Width="1" Height="16" Margin="10,0" />
                            <TextBlock Text="排序" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <ComboBox Width="160" Margin="8,0,0,0"
                                      ItemsSource="{Binding Gallery.SortOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Sort"
                                      SelectedValue="{Binding Gallery.Sort}" />
                        </StackPanel>
                    </Grid>

                    <!-- List + overlays -->
                    <Grid>
                        <ListBox x:Name="GalleryList"
                                 DataContext="{Binding Gallery}"
                                 ItemsSource="{Binding Items}"
                                 SelectionMode="Extended"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                 support:VirtualizedThumbnailLoader.Enabled="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Visibility="{Binding DataContext.IsLocalScope, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"
                                 SelectionChanged="GalleryList_SelectionChanged"
                                 MouseDoubleClick="GalleryList_MouseDoubleClick">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource GridPanelTemplate}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource GridCardTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource ListPanelTemplate}" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource ListRowTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBrowseView}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource BrowsePanelTemplate}" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource BrowseCardTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ContextMenu>
                                <!-- F-11: RelativeSource Self（ContextMenu 自身）而非 AncestorType=ContextMenu——
                                     在 ContextMenu 元素上查找同名祖先必然失败，导致 DataContext=null、全部命令静默失效 -->
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="打开（系统默认程序）" Command="{Binding OpenCommand}" />
                                    <MenuItem Header="在资源管理器中定位" Command="{Binding RevealCommand}" />
                                    <MenuItem Header="复制文件路径" Command="{Binding CopyPathCommand}" />
                                    <!-- U6-B：提交到共享库（仅选中项符合条件时可见，F-11 改绑 Shell 级 CanSubmitToShared） -->
                                    <MenuItem Header="提交到共享库"
                                              Visibility="{Binding CanSubmitToShared, Converter={StaticResource BoolVis}}"
                                              Command="{Binding DataContext.SubmitToSharedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <!-- M8-D：提交到副库（仅管理员可见，含各副库子项） -->
                                    <MenuItem Header="提交到副库"
                                              Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolVis}}"
                                              ItemsSource="{Binding DataContext.SecondaryNasConnections, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <Setter Property="Command" Value="{Binding DataContext.SubmitToSecondaryNasCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                    <MenuItem Header="评分">
                                        <MenuItem.ItemsSource>
                                            <x:Array Type="{x:Type sys:Int32}">
                                                <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
                                                <sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32>
                                            </x:Array>
                                        </MenuItem.ItemsSource>
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Header" Value="{Binding }" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="分类" ItemsSource="{Binding CategoryMenuOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Display}" />
                                                <Setter Property="Command" Value="{Binding DataContext.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Value}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="重新生成缩略图" Command="{Binding RegenerateThumbnailsCommand}" />
                                    <MenuItem Header="找相似图" Command="{Binding DataContext.FindSimilarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                    <MenuItem Header="从库中移除（Delete）" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- U6-A B2: 共享库 ListBox（与本地 ListBox 互斥，复用同一套卡片/行模板） -->
                        <ListBox x:Name="SharedGalleryList"
                                 DataContext="{Binding SharedGallery}"
                                 ItemsSource="{Binding Items}"
                                 SelectionMode="Extended"
                                 support:VirtualizedThumbnailLoader.Enabled="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Visibility="{Binding DataContext.IsSharedScope, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"
                                 SelectionChanged="SharedGalleryList_SelectionChanged">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource GridPanelTemplate}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource GridCardTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Gallery.IsListView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource ListPanelTemplate}" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource ListRowTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.Gallery.IsBrowseView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource BrowsePanelTemplate}" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource BrowseCardTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <!-- U6-A: 共享库空提示 -->
                        <Border Visibility="{Binding DataContext.IsSharedScope, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding SharedGallery.Items.Count, Converter={StaticResource ZeroVis}}">
                                <TextBlock Text="共享库中还没有图片" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="在本地库右键图片「提交到共享库」，等待管理员审核" />
                            </StackPanel>
                        </Border>

                        <!-- Empty library hint -->
                        <Border Visibility="{Binding DataContext.IsLocalScope, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Gallery.Items.Count, Converter={StaticResource ZeroVis}}">
                                <TextBlock Text="图库还是空的" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="点击左上角「＋ 导入图片」（Ctrl+I）开始建立素材库" />
                            </StackPanel>
                        </Border>

                        <!-- Undo bar -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,20" Padding="14,9" CornerRadius="8"
                                Background="{DynamicResource SurfaceActiveBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding UndoVisible, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" />
                                <Button Margin="12,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                        Padding="12,3" Content="撤销" Command="{Binding UndoCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ─── B3 详情栏 ─── -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- v0.13.0: 折叠态窄条（约 40px），点击展开详情 -->
                    <Button DockPanel.Dock="Left" Width="40"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding ToggleDetailPanelCommand}"
                            ToolTip="展开详情栏"
                            Visibility="{Binding IsDetailPanelCollapsed, Converter={StaticResource BoolVis}}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                              Data="{StaticResource IconExpand}" />
                    </Button>
                    <!-- 展开态：原有详情内容 -->
                    <DockPanel Visibility="{Binding IsDetailPanelExpanded, Converter={StaticResource BoolVis}}">
                        <!-- 折叠按钮（收起为窄条） -->
                        <Button DockPanel.Dock="Top" Height="28" HorizontalAlignment="Right"
                                Margin="0,4,8,0"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding ToggleDetailPanelCommand}"
                                ToolTip="收起详情栏">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                  Data="{StaticResource IconCollapse}" />
                        </Button>
                        <Grid>
                <Grid Visibility="{Binding IsLocalScope, Converter={StaticResource BoolVis}}">
                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Top" Margin="20"
                                Visibility="{Binding Detail.ShowEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="详情" Style="{StaticResource RegionLabelStyle}" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="在画廊中点选图片查看信息、评分、标签与备注；按住 Ctrl 可多选批量编辑。" />
                    </StackPanel>

                    <!-- Single -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Detail.IsSingle, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="详情" Style="{StaticResource SectionCaptionStyle}" />

                            <Border Height="240" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceVariantBrush}"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                                <Grid>
                                    <!-- M5-F: progressive image — thumb (placeholder) → preview (1024px) → original -->
                                    <controls:ProgressiveImage
                                        PlaceholderSource="{Binding Detail.Preview.ThumbnailImage}"
                                        PreviewSource="{Binding Detail.Preview.PreviewImage}"
                                        Stretch="Uniform" Margin="6" />
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Margin="8" Padding="0" CornerRadius="4"
                                            Background="{DynamicResource WarningBgBrush}"
                                            Visibility="{Binding Detail.IsMissing, Converter={StaticResource BoolVis}}">
                                        <Button Content="源文件缺失，点击重新定位"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="8,3" FontSize="11"
                                                Foreground="{DynamicResource WarningBrush}"
                                                Command="{Binding Detail.RelocateFileCommand}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource SubtleButtonStyle}" Content="打开原图"
                                        Command="{Binding Detail.OpenOriginalCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="定位" Command="{Binding Detail.RevealLocationCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="复制路径" Command="{Binding Detail.CopyPathCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="找相似"
                                        Command="{Binding FindSimilarCommand}"
                                        ToolTip="按 CLIP embedding 余弦相似度找出最相近的 50 张图" />
                            </StackPanel>

                            <TextBlock Text="评分" Margin="2,14,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl ItemsSource="{StaticResource RatingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="2"
                                                FontSize="20" Content="★"
                                                Command="{Binding DataContext.Detail.SetRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StarBrush}">
                                                    <Binding Path="DataContext.Detail.Rating" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding />
                                                    <Binding RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Button.Foreground>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- U4-A: B3-4 主色调色块（仅展示 + tooltip hex；未分析/无数据整行隐藏） -->
                            <StackPanel Visibility="{Binding Detail.HasDominantColors, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="主色调" Margin="2,12,0,0" Style="{StaticResource SectionCaptionStyle}" />
                                <ItemsControl ItemsSource="{Binding Detail.DominantColors}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="20" Height="20" CornerRadius="3" Margin="0,0,4,0"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                    Background="{Binding Converter={StaticResource HexBrush}}"
                                                    ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="分类" Margin="2,12,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ComboBox Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Detail.CategoryOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding Detail.SelectedCategory}" />

                            <TextBlock Text="标签" Margin="2,12,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl Margin="0,2,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding Detail.ImageTags}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <WrapPanel IsItemsHost="True" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" Margin="0,0,6,6"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="#" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Tag}" Margin="2,0,0,0" FontSize="12" />
                                                <TextBlock Text="AI" Margin="6,0,0,0" FontSize="10"
                                                           Foreground="{DynamicResource AccentDimBrush}"
                                                           Visibility="{Binding IsAi, Converter={StaticResource BoolVis}}" />
                                                <Button Content="×" Margin="4,0,0,0" Padding="2,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Command="{Binding RemoveCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Detail.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="支持 , ， 、 ; ； 换行/制表符 批量粘贴多个标签" />
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Content="添加标签" Command="{Binding Detail.AddTagCommand}" />
                            </Grid>

                            <TextBlock Text="备注" Margin="2,14,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Detail.NotesText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Top" />
                            <TextBlock Margin="2,6,0,0" Height="16" FontSize="11"
                                       Foreground="{DynamicResource AccentDimBrush}"
                                       Text="{Binding Detail.SaveHint}" />

                            <TextBlock Text="文件信息" Margin="2,8,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <Grid Margin="2,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.FileName}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.FormatText}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="尺寸" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.DimensionsText}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="大小" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.FileSizeText}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="导入时间" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.CreatedAtText}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="路径" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail.FilePath}" TextWrapping="Wrap" Margin="0,2"
                                           TextOptions.TextFormattingMode="Display" />
                            </Grid>

                            <!-- U2-C (§4.B.3): B3-9 相关资产 — hidden when the source has no embedding -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding Detail.HasRelatedAssets, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="相关资产" Style="{StaticResource SectionCaptionStyle}" />
                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding Detail.RelatedAssets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,0" Padding="0" BorderThickness="0"
                                                    ToolTip="{Binding FileName}"
                                                    Command="{Binding DataContext.Detail.SelectRelatedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border CornerRadius="6" ClipToBounds="True"
                                                        Width="64" Height="64"
                                                        Background="{DynamicResource SurfaceVariantBrush}">
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Batch -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Detail.IsBatch, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="批量编辑" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock Margin="2,0,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding Detail.SelectedCount, StringFormat='已选 {0} 张图片'}" />

                            <TextBlock Text="批量添加标签" Margin="2,18,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0"
                                     Text="{Binding Detail.BatchAddTagsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="多分隔符批量粘贴" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Content="添加到所选" Command="{Binding Detail.BatchAddTagsCommand}" />

                            <TextBlock Text="批量移除标签" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0"
                                     Text="{Binding Detail.BatchRemoveTagsText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Content="从所选中移除" Command="{Binding Detail.BatchRemoveTagsCommand}" />

                            <TextBlock Text="批量评分" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl ItemsSource="{StaticResource RatingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="2"
                                                FontSize="20" Content="★"
                                                Command="{Binding DataContext.Detail.BatchRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StarBrush}">
                                                    <Binding Source="5" />
                                                    <Binding />
                                                    <Binding RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Button.Foreground>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="批量分类" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl Margin="0,4,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding Detail.CategoryOptions}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <WrapPanel IsItemsHost="True" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButtonStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding DataContext.Detail.BatchCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ─── U6-D：B3 共享库详情（只读） ─── -->
                <Grid Visibility="{Binding IsSharedScope, Converter={StaticResource BoolVis}}">
                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Top" Margin="20"
                                Visibility="{Binding SharedDetail.ShowEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="详情" Style="{StaticResource RegionLabelStyle}" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="在共享库中点选图片查看信息；可将原图保存为本地副本。" />
                    </StackPanel>

                    <!-- Single (read-only) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SharedDetail.HasSelection, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="共享图片" Style="{StaticResource SectionCaptionStyle}" />

                            <Border Height="240" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceVariantBrush}">
                                <Image Source="{Binding SharedDetail.Preview.ThumbnailImage}"
                                       Stretch="Uniform" Margin="6" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="保存副本到…"
                                        Command="{Binding SharedDetail.SaveCopyCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="复制 NAS 路径"
                                        Command="{Binding SharedDetail.CopyNasPathCommand}" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SharedDetail.FileName}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SharedDetail.FormatText}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="尺寸" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SharedDetail.DimensionsText}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="大小" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SharedDetail.FileSizeText}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="评分" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SharedDetail.Rating, StringFormat='{}{0} ★'}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="分类" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SharedDetail.CategoryText}" Margin="0,2" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="标签" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SharedDetail.TagsSummary}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="提交者" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SharedDetail.SubmittedBy}" Margin="0,2" />
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="审核信息" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,2" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="SharedDetail.ApprovedBy" />
                                            <Binding Path="SharedDetail.ApprovedAtText" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="NAS 路径" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SharedDetail.NasPath}" TextWrapping="Wrap" Margin="0,2" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ C1 状态栏（C1-L 状态 / C1-C 计数 / C1-R 快捷键提示+AI 档位） ═══════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusBar.StatusText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusBar.FilteredCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding StatusBar.TotalCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusBar.ShortcutHint}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StatusBar.AiStatusText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <!-- W1/C1-NAME (v0.12.3)：AI 档位后追加软件英文名称+版本号 -->
                        <TextBlock Text=" · " FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersionText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>
                <!-- U2-A: indeterminate brand-gradient loading bar (import / AI / thumbnail generation) -->
                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentGradientBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding StatusBar.IsLoading, Converter={StaticResource BoolVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
