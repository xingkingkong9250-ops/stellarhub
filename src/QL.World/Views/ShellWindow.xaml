<Window x:Class="QL.World.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:support="clr-namespace:QL.World.Views.Support"
        xmlns:conv="clr-namespace:QL.World.Views.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:Width="1400" d:Height="850"
        Width="1400" Height="850"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <Window.Resources>
        <x:Array x:Key="RatingSteps" Type="{x:Type sys:Int32}">
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
        </x:Array>

        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroVis" />
        <conv:RatingStarBrushConverter x:Key="StarBrush" />

        <!-- U3-A (§4.B.2): B1-5 attribute filter chip — accent when active -->
        <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentDimBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- B2 grid card -->
        <DataTemplate x:Key="GridCardTemplate">
            <Border Margin="4" Padding="6"
                    Background="{DynamicResource SurfaceVariantBrush}"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <!-- B2-3-SEL：选中态 2px Accent 外描边（不改底色，底色由 ListBoxItem AccentBg 提供） -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Width="{Binding DataContext.GridZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.GridZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- U2-D (§4.C.2): B2-3-OL1 source badge (本地/云端/AI) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,4,4" Padding="4,1" CornerRadius="3"
                                    Background="{DynamicResource OverlayBrush}"
                                    Visibility="{Binding SourceBadge, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SourceBadge}" FontSize="10"
                                           Foreground="{DynamicResource TextOnOverlayBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="2,6,2,0">
                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="{Binding DimensionsText}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding Rating, StringFormat='★{0}'}"
                                       Visibility="{Binding Rating, Converter={StaticResource ZeroVis}, ConverterParameter=Invert}" />
                        </Grid>
                        <!-- U2-E (§4.D.1): tag summary row (first 2 + +N); hidden when no tags -->
                        <TextBlock Text="{Binding TagsSummary}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TagsSummary, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                    <Border Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="文件缺失" Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- B2 list row -->
        <DataTemplate x:Key="ListRowTemplate">
            <Border Height="{Binding DataContext.ListRowHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <!-- B2-3-SEL 列表态：左 3px Accent 竖条 + 底线；Padding 同步减 3px 抵消 layout shift -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="3,0,0,1" />
                                <Setter Property="Padding" Value="5,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="{Binding DataContext.ListZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.ListZoom, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource SurfaceVariantBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                            <!-- U2-D (§4.C.2): B2-3-OL1 source badge (本地/云端/AI) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,3,3,0" Padding="3,0" CornerRadius="2"
                                    Background="{DynamicResource OverlayBrush}"
                                    Visibility="{Binding SourceBadge, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SourceBadge}" FontSize="9"
                                           Foreground="{DynamicResource TextOnOverlayBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding TagsCsv}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding DimensionsText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                               Text="{Binding CategoryText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                               Text="{Binding FileSizeText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding Rating, StringFormat='★{0}'}" />
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanelTemplate">
            <support:VirtualizingTilePanel
                ItemWidth="{Binding DataContext.GridCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                ItemHeight="{Binding DataContext.GridCardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding TopBar.ImportCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SetRatingCommand}" CommandParameter="5" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════ A1 顶栏 ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- U2-A: brand gradient Logo block -->
                    <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0"
                            Background="{DynamicResource AccentGradientBrush}" />
                    <TextBlock Text="QL World" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="素材库" Margin="10,2,0,0" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Button Margin="16,0,0,0" Style="{StaticResource AccentButtonStyle}"
                            Content="＋ 导入图片" Command="{Binding TopBar.ImportCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource AiButtonStyle}"
                            Content="AI 分析" ToolTip="{Binding TopBar.AiDisabledReason}"
                            Command="{Binding TopBar.AiCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}"
                            Content="分析颜色" ToolTip="为缺失主色调的图片批量回填 dominant_colors"
                            Command="{Binding TopBar.ColorCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- U2-B (§4.B.1): 最近入库 dropdown -->
                    <ComboBox Width="118"
                              ItemsSource="{Binding TopBar.RecentImportOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Days"
                              SelectedValue="{Binding TopBar.SelectedRecentImport}" />
                    <Border Width="1" Height="24" Margin="12,0"
                            Background="{DynamicResource BorderSubtleBrush}" />
                    <TextBox x:Name="SearchTextBox" Width="240" Height="32"
                             AutomationProperties.Name="SearchBox"
                             VerticalContentAlignment="Center"
                             Text="{Binding TopBar.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索（300ms 防抖）" />
                    <ComboBox Width="118" Margin="8,0,0,0"
                              ItemsSource="{Binding TopBar.SearchModes}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding TopBar.SelectedSearchMode}" />

                    <Border Width="1" Height="24" Margin="12,0"
                            Background="{DynamicResource BorderSubtleBrush}" />

                    <ToggleButton Style="{StaticResource ToggleButtonStyle}"
                                  IsChecked="{Binding TopBar.IsGridView}"
                                  Content="▦ 网格" ToolTip="网格视图" />
                    <ToggleButton Style="{StaticResource ToggleButtonStyle}" Margin="4,0,0,0"
                                  IsChecked="{Binding Gallery.IsListView}"
                                  Content="≡ 列表" ToolTip="列表视图" />

                    <Border Width="1" Height="24" Margin="12,0"
                            Background="{DynamicResource BorderSubtleBrush}" />

                    <Grid>
                        <Button x:Name="NotificationsButton" Style="{StaticResource SubtleButtonStyle}" Content="🔔"
                                ToolTip="消息中心"
                                Command="{Binding TopBar.NotificationsCommand}" />
                        <Ellipse Width="9" Height="9"
                                 Fill="{DynamicResource WarningBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0"
                                 Visibility="{Binding TopBar.Notifications.HasUnreadBadge, Converter={StaticResource BoolVis}}" />
                        <Popup PlacementTarget="{Binding ElementName=NotificationsButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding TopBar.Notifications.IsPopupOpen, Mode=TwoWay}">
                            <Border Width="340" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="消息中心" FontWeight="Bold" Margin="2,0,0,6"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ListBox Grid.Row="1" MaxHeight="360" MinHeight="48"
                                             ItemsSource="{Binding TopBar.Notifications.Items}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{DynamicResource WarningBrush}"
                                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolVis}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                               MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CreatedAtText}" FontSize="10" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="1" Text="暂无消息" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="12" Margin="0,14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding TopBar.Notifications.Items.Count, Converter={StaticResource ZeroVis}}" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Content="全部已读"
                                                Command="{Binding TopBar.Notifications.MarkAllReadCommand}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}" Content="清空" Margin="6,0,0,0"
                                                Command="{Binding TopBar.Notifications.ClearAllCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="⚙" Margin="4,0,0,0"
                            ToolTip="设置（M2 开放）"
                            Command="{Binding TopBar.SettingsCommand}" />
                    <TextBlock Text="{Binding VersionText}" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ B 主分区 ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="220" MaxWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="280" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- ─── B1 左栏 ─── -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,8,12">
                    <StackPanel>
                        <TextBlock Text="素材库" Style="{StaticResource SectionCaptionStyle}" />
                        <ItemsControl ItemsSource="{Binding TagTree.CategoryNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TreeToggleStyle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}">
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Count}" />
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="2,8,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource ChipActiveButtonStyle}"
                                Content="✕ 清除全部筛选"
                                Visibility="{Binding Gallery.FilterSummary, Converter={StaticResource NullVis}}"
                                Command="{Binding ClearFiltersCommand}" />

                        <TextBlock Text="收藏夹" Margin="2,16,0,0"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        <Button Content="＋ 新建" Style="{StaticResource ChipActiveButtonStyle}"
                                Margin="0,4,0,0" HorizontalAlignment="Left"
                                Command="{Binding CreateCollectionCommand}" />
                        <ItemsControl ItemsSource="{Binding CollectionTree.CollectionNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TreeToggleStyle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  AllowDrop="True"
                                                  Drop="OnCollectionDrop">
                                        <ToggleButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名…"
                                                          Command="{Binding DataContext.RenameCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="删除…"
                                                          Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="设为封面（当前所选）"
                                                          Command="{Binding DataContext.SetCollectionCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ToggleButton.ContextMenu>
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Count}" />
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="热门标签（Top 50）" Margin="2,16,0,0"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        <ItemsControl Margin="2,0,0,0"
                                      ItemsSource="{Binding TagTree.TopTagNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButtonStyle}"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="#" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Tag}" Margin="2,0,0,0" />
                                            <TextBlock Text="{Binding Count, StringFormat=' {0}'}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="贴图组" Margin="2,16,0,0"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        <ItemsControl ItemsSource="{Binding PbrGroupTree.GroupNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource TreeToggleStyle}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}">
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding MemberCount}" />
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- U3-A (§4.B.2): B1-5 属性筛选（默认收起，折叠态持久化） -->
                        <ToggleButton Margin="2,16,0,0"
                                      Style="{StaticResource SidebarSectionHeaderStyle}"
                                      AutomationProperties.Name="属性筛选"
                                      IsChecked="{Binding AttributeFilter.IsExpanded}"
                                      Content="属性筛选" />
                        <StackPanel Margin="2,0,0,0"
                                    Visibility="{Binding AttributeFilter.IsExpanded, Converter={StaticResource BoolVis}}">
                            <!-- B1-5-1 颜色 -->
                            <TextBlock Text="颜色" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding AttributeFilter.ColorOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterChipStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- B1-5-2 分辨率 -->
                            <TextBlock Text="分辨率（长边）" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding AttributeFilter.ResolutionOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterChipStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- B1-5-3 文件大小 -->
                            <TextBlock Text="文件大小" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding AttributeFilter.FileSizeOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterChipStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- B1-5-4 评分 -->
                            <TextBlock Text="评分" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <ItemsControl ItemsSource="{Binding AttributeFilter.RatingOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterChipStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding SelectCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ─── B2 画廊 ─── -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <DockPanel>
                    <!-- B2 toolbar -->
                    <Grid DockPanel.Dock="Top" Height="40" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="显示" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Gallery.FilteredCount}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="张 / 共" Margin="6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Gallery.TotalCount}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource BorderSubtleBrush}"
                                    Width="1" Height="16" Margin="10,0" />
                            <TextBlock Text="{Binding Gallery.FilterSummary}" FontSize="12"
                                       Foreground="{DynamicResource AccentDimBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Gallery.FilterSummary, Converter={StaticResource NullVis}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- B2-4 zoom (grid) -->
                            <Slider x:Name="GridZoomSlider" Width="120" Minimum="80" Maximum="512"
                                    TickFrequency="8" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Gallery.IsGridView, Converter={StaticResource BoolVis}}" />
                            <!-- B2-4 zoom (list) -->
                            <Slider x:Name="ListZoomSlider" Width="120" Minimum="80" Maximum="512"
                                    TickFrequency="8" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Gallery.IsListView, Converter={StaticResource BoolVis}}" />
                            <Border Background="{DynamicResource BorderSubtleBrush}"
                                    Width="1" Height="16" Margin="10,0" />
                            <TextBlock Text="排序" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <ComboBox Width="160" Margin="8,0,0,0"
                                      ItemsSource="{Binding Gallery.SortOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Sort"
                                      SelectedValue="{Binding Gallery.Sort}" />
                        </StackPanel>
                    </Grid>

                    <!-- List + overlays -->
                    <Grid>
                        <ListBox x:Name="GalleryList"
                                 DataContext="{Binding Gallery}"
                                 ItemsSource="{Binding Items}"
                                 SelectionMode="Extended"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                 support:VirtualizedThumbnailLoader.Enabled="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="GalleryList_SelectionChanged"
                                 MouseDoubleClick="GalleryList_MouseDoubleClick">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="ItemsPanel" Value="{StaticResource GridPanelTemplate}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource GridCardTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource ListPanelTemplate}" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource ListRowTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem Header="打开（系统默认程序）" Command="{Binding OpenCommand}" />
                                    <MenuItem Header="在资源管理器中定位" Command="{Binding RevealCommand}" />
                                    <MenuItem Header="复制文件路径" Command="{Binding CopyPathCommand}" />
                                    <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                    <MenuItem Header="评分">
                                        <MenuItem.ItemsSource>
                                            <x:Array Type="{x:Type sys:Int32}">
                                                <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
                                                <sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32>
                                            </x:Array>
                                        </MenuItem.ItemsSource>
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Header" Value="{Binding }" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="分类" ItemsSource="{Binding CategoryMenuOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Display}" />
                                                <Setter Property="Command" Value="{Binding DataContext.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Value}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="重新生成缩略图" Command="{Binding RegenerateThumbnailsCommand}" />
                                    <MenuItem Header="找相似图" Command="{Binding DataContext.FindSimilarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                    <MenuItem Header="从库中移除（Delete）" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- Empty library hint -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Gallery.Items.Count, Converter={StaticResource ZeroVis}}">
                            <TextBlock Text="图库还是空的" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="点击左上角「＋ 导入图片」（Ctrl+I）开始建立素材库" />
                        </StackPanel>

                        <!-- Undo bar -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,20" Padding="14,9" CornerRadius="8"
                                Background="{DynamicResource SurfaceActiveBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding UndoVisible, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" />
                                <Button Margin="12,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                        Padding="12,3" Content="撤销" Command="{Binding UndoCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ─── B3 详情栏 ─── -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Top" Margin="20"
                                Visibility="{Binding Detail.ShowEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="详情" Style="{StaticResource RegionLabelStyle}" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="在画廊中点选图片查看信息、评分、标签与备注；按住 Ctrl 可多选批量编辑。" />
                    </StackPanel>

                    <!-- Single -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Detail.IsSingle, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="详情" Style="{StaticResource SectionCaptionStyle}" />

                            <Border Height="240" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceVariantBrush}"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                                <Grid>
                                    <Image Source="{Binding Detail.Preview.ThumbnailImage}"
                                           Stretch="Uniform" Margin="6" />
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Margin="8" Padding="0" CornerRadius="4"
                                            Background="{DynamicResource WarningBgBrush}"
                                            Visibility="{Binding Detail.IsMissing, Converter={StaticResource BoolVis}}">
                                        <Button Content="源文件缺失，点击重新定位"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="8,3" FontSize="11"
                                                Foreground="{DynamicResource WarningBrush}"
                                                Command="{Binding Detail.RelocateFileCommand}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource SubtleButtonStyle}" Content="打开原图"
                                        Command="{Binding Detail.OpenOriginalCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="定位" Command="{Binding Detail.RevealLocationCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="复制路径" Command="{Binding Detail.CopyPathCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0"
                                        Content="找相似"
                                        Command="{Binding FindSimilarCommand}"
                                        ToolTip="按 CLIP embedding 余弦相似度找出最相近的 50 张图" />
                            </StackPanel>

                            <TextBlock Text="评分" Margin="2,14,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl ItemsSource="{StaticResource RatingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="2"
                                                FontSize="20" Content="★"
                                                Command="{Binding DataContext.Detail.SetRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StarBrush}">
                                                    <Binding Path="DataContext.Detail.Rating" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding />
                                                    <Binding RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Button.Foreground>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="分类" Margin="2,12,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ComboBox Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Detail.CategoryOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding Detail.SelectedCategory}" />

                            <TextBlock Text="标签" Margin="2,12,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl Margin="0,2,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding Detail.ImageTags}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <WrapPanel IsItemsHost="True" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" Margin="0,0,6,6"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="#" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Tag}" Margin="2,0,0,0" FontSize="12" />
                                                <TextBlock Text="AI" Margin="6,0,0,0" FontSize="10"
                                                           Foreground="{DynamicResource AccentDimBrush}"
                                                           Visibility="{Binding IsAi, Converter={StaticResource BoolVis}}" />
                                                <Button Content="×" Margin="4,0,0,0" Padding="2,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Command="{Binding RemoveCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Detail.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="支持 , ， 、 ; ； 换行/制表符 批量粘贴多个标签" />
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Content="添加标签" Command="{Binding Detail.AddTagCommand}" />
                            </Grid>

                            <TextBlock Text="备注" Margin="2,14,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Detail.NotesText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Top" />
                            <TextBlock Margin="2,6,0,0" Height="16" FontSize="11"
                                       Foreground="{DynamicResource AccentDimBrush}"
                                       Text="{Binding Detail.SaveHint}" />

                            <TextBlock Text="文件信息" Margin="2,8,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <Grid Margin="2,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.FileName}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.FormatText}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="尺寸" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.DimensionsText}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="大小" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.FileSizeText}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="导入时间" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.CreatedAtText}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="路径" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail.FilePath}" TextWrapping="Wrap" Margin="0,2"
                                           TextOptions.TextFormattingMode="Display" />
                            </Grid>

                            <!-- U2-C (§4.B.3): B3-9 相关资产 — hidden when the source has no embedding -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding Detail.HasRelatedAssets, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="相关资产" Style="{StaticResource SectionCaptionStyle}" />
                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding Detail.RelatedAssets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,0" Padding="0" BorderThickness="0"
                                                    ToolTip="{Binding FileName}"
                                                    Command="{Binding DataContext.Detail.SelectRelatedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border CornerRadius="6" ClipToBounds="True"
                                                        Width="64" Height="64"
                                                        Background="{DynamicResource SurfaceVariantBrush}">
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Batch -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Detail.IsBatch, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="批量编辑" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock Margin="2,0,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding Detail.SelectedCount, StringFormat='已选 {0} 张图片'}" />

                            <TextBlock Text="批量添加标签" Margin="2,18,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0"
                                     Text="{Binding Detail.BatchAddTagsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="多分隔符批量粘贴" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Content="添加到所选" Command="{Binding Detail.BatchAddTagsCommand}" />

                            <TextBlock Text="批量移除标签" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBox Margin="0,2,0,0"
                                     Text="{Binding Detail.BatchRemoveTagsText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Content="从所选中移除" Command="{Binding Detail.BatchRemoveTagsCommand}" />

                            <TextBlock Text="批量评分" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl ItemsSource="{StaticResource RatingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="2"
                                                FontSize="20" Content="★"
                                                Command="{Binding DataContext.Detail.BatchRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Foreground>
                                                <MultiBinding Converter="{StaticResource StarBrush}">
                                                    <Binding Source="5" />
                                                    <Binding />
                                                    <Binding RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Button.Foreground>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="批量分类" Margin="2,16,0,0" Style="{StaticResource SectionCaptionStyle}" />
                            <ItemsControl Margin="0,4,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding Detail.CategoryOptions}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <WrapPanel IsItemsHost="True" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButtonStyle}"
                                                Content="{Binding Display}"
                                                Command="{Binding DataContext.Detail.BatchCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ C1 状态栏（C1-L 状态 / C1-C 计数 / C1-R 快捷键提示+AI 档位） ═══════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusBar.StatusText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusBar.FilteredCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding StatusBar.TotalCount}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusBar.ShortcutHint}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StatusBar.AiStatusText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <!-- U2-A: indeterminate brand-gradient loading bar (import / AI / thumbnail generation) -->
                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentGradientBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding StatusBar.IsLoading, Converter={StaticResource BoolVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
