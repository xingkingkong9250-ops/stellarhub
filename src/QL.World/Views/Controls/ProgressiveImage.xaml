<UserControl x:Class="QL.World.Views.Controls.ProgressiveImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- M5-F: three-layer progressive fade-in. Bottom = thumb (placeholder),
             middle = preview (1024px), top = original. Each layer starts at
             opacity 0; when its source arrives it fades in over 200ms, and
             only then is the layer below it collapsed (never collapse-then-fade
             — that flickers). -->
        <Image x:Name="PlaceholderLayer"
               Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="PreviewLayer" Opacity="0"
               Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="FinalLayer" Opacity="0"
               Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</UserControl>
