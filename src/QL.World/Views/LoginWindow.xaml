<Window x:Class="QL.World.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:QL.World.Views.Converters"
        mc:Ignorable="d"
        Width="420" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="登录 — 千星汇图">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolVis" Parameter="Invert" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="千星汇图" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Margin="0,4,0,20"
                       Text="请登录以使用共享图库" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" />

            <!-- NAS 连接 -->
            <TextBlock Grid.Row="2" Text="NAS 连接" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox Grid.Row="2" Margin="0,18,0,0"
                      ItemsSource="{Binding NasConnections}"
                      SelectedItem="{Binding SelectedConnection}"
                      DisplayMemberPath="Name"
                      Height="28"
                      Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- 用户名 -->
            <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="用户名" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="3" Margin="0,30,0,0"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- 密码 -->
            <TextBlock Grid.Row="4" Margin="0,12,0,0" Text="密码" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="4" Margin="0,30,0,0"
                         Height="28"
                         Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- 错误消息 -->
            <TextBlock Grid.Row="5" Margin="0,12,0,0"
                       Text="{Binding ErrorMessage}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullVis}}"
                       VerticalAlignment="Top" />

            <!-- 按钮区 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LoginButton" Content="登录" Width="96" Height="30" Margin="0,0,8,0"
                        Click="OnLoginClick"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="仅本地模式" Width="96" Height="30" Margin="8,0,0,0"
                        Click="OnLocalModeClick"
                        Style="{StaticResource SubtleButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
